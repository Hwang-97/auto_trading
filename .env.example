# API Keys
GOOGLE_API_KEY=your-google-api-key-here
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
NASDAQ_API_KEY=your-nasdaq-api-key
NEWS_API_KEY=your-news-api-key

# Database Configuration
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_data
DB_USER=stock_user
DB_PASSWORD=your-password

# Data Collection Settings
COLLECTION_INTERVAL_MINUTES=15
BATCH_SIZE=1000
MAX_WORKERS=4

# File Paths
XLSX_WATCH_PATH=./data/imports
LOG_PATH=./logs
DB_PATH=./data/databases

# System Settings
DEBUG=false
GEMINI_YOLO_MODE=true
AUTO_README_UPDATE=true
AUTO_DEPENDENCY_INSTALL=true
SKIP_CONFIRMATIONS=true
AUTO_PLAN_EXECUTION=true
AUTO_PORTABLE_BUILD=true